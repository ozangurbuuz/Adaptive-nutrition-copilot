# Local development only. Copy this file to .env and replace placeholders.
APP_ENV=local

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=adaptive_nutrition
POSTGRES_USER=adaptive_nutrition
POSTGRES_PASSWORD=<set-a-local-password>

# Optional. When omitted, DATABASE_URL is built from the POSTGRES_* values above.
# DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>
